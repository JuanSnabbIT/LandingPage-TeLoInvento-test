# Destino del formulario de contacto y de la lista de espera de Hogar.
# Ver src/lib/submitLead.ts. Copiar a `.env.local` (ignorado por git) y completar
# UNA de las dos opciones cuando el negocio decida el destino real
# (vault: 09-registro-decisiones.md, decisión abierta T13).

# Opción A: backend / servicio que acepta POST JSON (Formspree, función serverless, API propia).
VITE_LEAD_ENDPOINT=

# Opción B: sin backend, abre el cliente de correo del visitante con el lead pre-cargado.
VITE_LEAD_FALLBACK_EMAIL=
